####
# This Dockerfile is used in order to build a container that runs the Quarkus application in native (no JVM) mode.
#
# Before building the container image run:
#
# ./mvnw package -Dnative
#
# Then, build the image with:
#
# docker build -f src/main/docker/Dockerfile.native -t quarkus/testservice .
#
# Then run the container using:
#
# docker run -i --rm -p 8080:8080 quarkus/testservice
#
###
FROM registry.access.redhat.com/ubi8/ubi-minimal:8.9

USER root
# AWT in the native executable loads freetype and fontconfig at runtime, and
# the watermark needs a font for "Sans-Serif" (the JVM image has DejaVu Sans).
RUN microdnf install freetype fontconfig dejavu-sans-fonts \
    && microdnf update \
    && microdnf clean all

WORKDIR /work/
RUN chown 1001 /work \
    && chmod "g+rwX" /work \
    && chown 1001:root /work
COPY --chown=1001:root target/*-runner /work/application
# With AWT, the native build emits JDK libraries (libawt.so, libjavajpeg.so,
# libfontmanager.so, ...) that must sit next to the executable. Without them
# every image request fails with "UnsatisfiedLinkError: No awt".
COPY --chown=1001:root target/*.so /work/

EXPOSE 8080
USER 1001

ENTRYPOINT ["./application", "-Dquarkus.http.host=0.0.0.0"]
